# Supabase project — the anon key is publishable and ships in the browser
# bundle by design, but keep real values out of the repo: copy this file to
# .env.local and fill it in.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Django API. The browser calls it directly with a Bearer token; this origin
# must be listed in the backend's CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
