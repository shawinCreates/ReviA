# Copy to .env and fill in. Never commit .env.
# Supabase: Project Settings -> API. The project ref is the subdomain in your
# project's URL (https://<ref>.supabase.co) and appears in the S3 endpoint.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres. Use the SESSION POOLER host, not the direct host:
# Render has no IPv6, so the direct connection fails. Pooler port is 5432;
# the transaction pooler is 6543.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# Supabase REST/auth. SUPABASE_URL is needed to derive the JWKS endpoint, and
# the anon key is what the browser signs in with.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=

# Supabase S3-compatible storage
SUPABASE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=document
SUPABASE_S3_REGION=us-east-1

# Groq. See quotas.md before choosing a model: per-model daily token limits
# differ by 5x and the model is a config value, not a constant.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings run locally via ONNX Runtime, not Cloudflare. Measured: torch alone
# is 489MB, which is the whole Render Free budget; ONNX + bge-small is 274MB.
# EMBEDDING_DIM and EMBED_MODEL must agree, and changing the model requires
# re-embedding every stored chunk. See architecture.md "Embeddings".
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Cloudflare Workers AI. No longer used for embeddings; kept because the
# Reranker and future providers may reuse the same OpenAI-compatible client.
CF_API_KEY=
CF_ACCOUNT_ID=
CF_EMBED_MODEL=@cf/baai/bge-m3

# Cohere rerank. Free tier is ~1000 calls/month and exhausts fast, so this is
# behind a Reranker interface with a silent no-op fallback. See retrieval.md.
COHERE_API_KEY=
