# Copy to .env and fill in. Never commit .env.
# Supabase: Project Settings -> API. The project ref is the subdomain in your
# project's URL (https://<ref>.supabase.co) and appears in the S3 endpoint.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The browser holds the Supabase session cookie and calls this API
# cross-origin with credentials, so the origin must be listed explicitly. A
# wildcard cannot be used with credentialed requests.
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_LOG_LEVEL=INFO

# Supabase Postgres. Use the SESSION POOLER host, not the direct host: deploy
# targets without IPv6 fail on the direct host, and the failure looks like a
# networking problem rather than the wrong host. Pooler port is 5432; the
# transaction pooler is 6543.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# Seconds to keep a Postgres connection open between requests. 0 closes it after
# every request, which is what tests use.
SUPABASE_DB_CONN_MAX_AGE=60

# Token verification calls Supabase Auth once per distinct token, then caches by
# token hash for this many seconds. A verified token is immutable, so the cache
# cannot go stale; 0 disables caching and makes every request a network call.
SUPABASE_AUTH_CACHE_SECONDS=300
SUPABASE_AUTH_TIMEOUT_SECONDS=5

# The database used by `pytest`. Defaults to in-memory SQLite, which keeps the
# suite hermetic: it never creates or drops a database on the live project.
# Set to postgres to exercise the parts SQLite cannot do, such as pgvector.
REVIA_TEST_DB=sqlite

# A LOCAL Postgres to run the suite against when REVIA_TEST_DB=postgres. This
# must not be the Supabase project: Django creates and drops a test database
# around every run, and Supabase's pooler holds an idle session that blocks the
# drop, which leaves a stray database behind on a shared project. The settings
# refuse to fall back to Supabase rather than risk that.
#
#   docker run -d --name revia-test-pg -p 5433:5432 \
#     -e POSTGRES_PASSWORD=revia pgvector/pgvector:pg16
#
# Then: REVIA_TEST_DB=postgres REVIA_TEST_PG_HOST=127.0.0.1 \
#       REVIA_TEST_PG_PORT=5433 REVIA_TEST_PG_USER=postgres \
#       REVIA_TEST_PG_PASSWORD=revia uv run pytest
#
# The container also needs an `anon` role, which plain Postgres does not have.
# The RLS tests check that role cannot read the tables, and skip without it:
#   docker exec revia-test-pg psql -U postgres -d postgres \
#     -c "DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='anon')
#         THEN CREATE ROLE anon NOLOGIN NOINHERIT; END IF; END $$;"
#   docker exec revia-test-pg psql -U postgres -d postgres -c "GRANT anon TO postgres"
REVIA_TEST_PG_HOST=
REVIA_TEST_PG_PORT=5432
REVIA_TEST_PG_USER=postgres
REVIA_TEST_PG_PASSWORD=
# The database to connect to, used only to CREATE DATABASE. Defaults to
# postgres, which always exists. Not the same thing as the test database.
REVIA_TEST_PG_NAME=postgres
# Overrides the derived `test_<name>` for the test database itself. Rarely needed.
REVIA_TEST_PG_TEST_NAME=

# Supabase REST/auth. SUPABASE_URL identifies the project, and the anon key is
# what the browser signs in with and what the backend presents when asking
# Supabase Auth to verify a session cookie.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=

# Supabase S3-compatible storage, for uploaded files.
SUPABASE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
# The bucket name, which is whatever you created in Storage — it is often not
# "document". Find it under Storage -> Buckets in the dashboard.
SUPABASE_S3_BUCKET=
SUPABASE_S3_REGION=us-east-1

# Embeddings. EMBED_MODEL and EMBEDDING_DIM must agree, and changing either means
# re-embedding every stored chunk — vectors from two models are not comparable
# even at the same dimension.
#
# Embedding runs on Cloudflare Workers AI in production and locally alike: the
# free tier grants 10,000 neurons/day, and the same weights the stored vectors
# were made with, so nothing ever needs re-embedding. CLOUDFLARE_ACCOUNT_ID is
# in the dashboard under Workers & Pages; CLOUDFLARE_API_TOKEN is an API token
# with Account/Workers AI/Edit. When a day's neurons are spent, embedding fails
# until the 00:00 UTC reset and the document can be re-ingested afterwards.
#
# The request pins pooling:"cls" and normalises the response, which keeps what
# comes back interchangeable with what wrote the stored vectors. Changing either
# makes vectors from before and after unreconcilable, so treat them as part of
# EMBED_MODEL. See docs/DESIGN.md, Embeddings.
#
# 384 is not arbitrary: it is what migration 0002 baked into the chunks table, and
# the HNSW index over it is built for that width. Changing the number needs a
# migration and a full re-embed, so treat the two as one decision.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4

# How far a retrieved passage may be from the question, as a cosine distance,
# and still be treated as on topic. Higher recalls more and cites less
# precisely. See the comment on `retrieval.MAX_COSINE_DISTANCE`.
RETRIEVAL_MAX_DISTANCE=0.45

# The answer model. GROQ_MODEL must be a model the key has access to; a
# restricted key gets 404 for the larger models, which is not obvious from the
# error.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CHAT_CONTEXT_WINDOW=131072
ANSWER_MAX_TOKENS=1200
ANSWER_TEMPERATURE=0.1
CHAT_HISTORY_TURNS=8
CHAT_HISTORY_MAX_TOKENS=3000
MAX_QUESTION_CHARS=4000

# Uploads.
MAX_UPLOAD_BYTES=26214400

# How PDFs are read. `fast` uses pdfminer: text and page numbers with no OCR or
# layout model, so PDFs chunk by paragraph. `hi_res` runs the layout model,
# which recognises section headings (and so drives section chunking) but is
# slower, pulls in torch, and needs poppler plus a one-time model download —
# too heavy for the free tier, so the deployment default is `fast`.
PDF_PARTITION_STRATEGY=fast

# Rate limits, as "<count> per <window>". The `session` limit applies to ordinary
# reads and writes, keyed on the session cookie. `generation` and `upload` are
# for the two endpoints that cost money or storage per call, so a cookie session
# cannot be used to run up a bill. Raise these before raising anything else.
THROTTLE_SESSION_PER_MINUTE=60
THROTTLE_GENERATION_PER_HOUR=60
THROTTLE_UPLOAD_PER_HOUR=120
